{
    "name": "xola/reportwriter-bundle",
    "description": "Generic report writer bundle for exporting tabular data to CSV and Excel (Symfony 5.4, PHP 7.4)",
    "keywords": [
        "symfony",
        "bundle",
        "report",
        "csv",
        "excel",
        "export"
    ],
    "require": {
        "ext-json": "*",
        "php": "^7.4",
        "symfony/framework-bundle": "^5.4",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "phpoffice/phpspreadsheet": "^1.3"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Rushi Vishavadia",
            "email": "rushi@xola.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Xola\\ReportWriterBundle\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "coverage": "phpunit --configuration phpunit.xml.dist --coverage-text"
    }
}
